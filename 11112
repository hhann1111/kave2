body {
    margin: 0;
    font-family: Arial, sans-serif;
    text-align: center;
    background-color: #f4f4f4;
}

header {
    background-color: #333;
    color: white;
    padding: 20px;
}

main {
    padding: 40px;
}

img {
    width: 60%;
    max-width: 600px;
    border-radius: 10px;
}

p {
    font-size: 20px;
    margin-top: 20px;
}

footer {
    background-color: #333;
    color: white;
    padding: 15px;
    position: fixed;
    width: 100%;
    bottom: 0;
}
